{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhaRa",
  "version": "0.1.0",
  "identifier": "com.whara.desktop",
  "build": {
    "frontendDist": "../prefs"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "chat-remote-bridge",
        "prefs-local-bridge"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}