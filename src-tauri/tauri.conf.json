{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhaRa",
  "version": "0.2.0",
  "identifier": "com.whara.desktop",
  "build": {
    "frontendDist": "../prefs"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null,
      "capabilities": [
        "chat-remote-bridge",
        "prefs-local-bridge",
        "updates-local"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNENEQzRDlERTVDQjNCQjIKUldTeU84dmxuVDFOUFVRZ1hHSTdwYTF4OXQ5VmlzMk9ER2x0eG8rNlp3QWxnYzI2bTZuU2RVWDAK",
      "endpoints": [
        "https://github.com/rayenking/WhaRa/releases/latest/download/latest.json"
      ]
    }
  }
}
